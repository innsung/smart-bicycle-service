# Database (MySQL 사용 시 입력, 비워두면 개발용 SQLite 사용)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastapi_db

# JWT - 실제 실행 환경에서는 충분히 긴 임의 문자열로 교체
ACCESS_SECRET=change-this-access-secret
REFRESH_SECRET=change-this-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false

# External APIs
SEOUL_OPEN_DATA_API_KEY=
SEOUL_OPEN_DATA_API_BASE_URL=http://openapi.seoul.go.kr:8088
KMA_SERVICE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Runtime
REALTIME_CACHE_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
