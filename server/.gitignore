.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
data/ml_processed/
data/external/*.csv
reports/eda/

# 서울시 원본 데이터는 수십 GB이므로 Git에 커밋하지 않습니다.
data/*
!data/usage/
data/usage/*
!data/usage/.gitkeep
!data/usage/README.md
# 분석 JSON 캐시와 로컬 DB는 포함하되 CSV 원본은 계속 제외합니다.
!data/processed/
data/processed/*
!data/processed/usage_analysis_latest.json
!data/smart_bicycle.db
data1/
data2/
data3/

# ML 모델과 평가 JSON은 포함하고 추론 CSV 등 대용량 파일은 제외합니다.
models/artifacts/*
!models/artifacts/*.joblib
!models/artifacts/*.json
# 과제 제출 및 운영 추론에 필요한 경량 Feature 저장소(약 9.6MB)
!models/artifacts/inference_features.csv
*.pkl
*.parquet
